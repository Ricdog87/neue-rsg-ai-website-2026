# HubSpot Meetings — public scheduling URL
NEXT_PUBLIC_HUBSPOT_MEETING_URL=https://meetings-eu1.hubspot.com/r-serrano

# Calendly fallback (optional)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/rsg-ai/demo

# Plausible / Vercel Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=rsg-ai.de
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Site
NEXT_PUBLIC_SITE_URL=https://www.rsg-ai.de

# Newsletter — Resend transactional sender (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# HMAC secret for double-opt-in tokens (any long random string)
NEWSLETTER_SECRET=replace-me-with-32-bytes-of-randomness

# Fonio Voice AI — Outbound Callback
FONIO_API_URL=https://api.fonio.ai/v1/outbound/start
FONIO_API_KEY=fonio_replace_me
FONIO_FROM_NUMBER=+49REPLACE
FONIO_AGENT_ID=replace_me

# ── Stripe Checkout (Preise-Seite / KI-Sprachagenten Solo & Team) ─────────────
#
# Schritt 1: Stripe-Dashboard → Produkte → Abonnements anlegen:
#   - Solo Monatlich: 199 EUR/Monat → Price-ID kopieren
#   - Solo Jaehrlich: 169 EUR/Monat (jaehrlich abgerechnet) → Price-ID kopieren
#   - Team Monatlich: 499 EUR/Monat → Price-ID kopieren
#   - Team Jaehrlich: 424 EUR/Monat (jaehrlich abgerechnet) → Price-ID kopieren
#
# Schritt 2: Einmalige Setup-Produkte anlegen:
#   - Setup Solo: 490 EUR einmalig → Price-ID kopieren
#   - Setup Team: 990 EUR einmalig → Price-ID kopieren
#
# Schritt 3: Diese Variablen in Vercel → Settings → Environment Variables eintragen.
# WICHTIG: STRIPE_SECRET_KEY NIEMALS ins Git commiten!
#
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PRICE_SOLO_MONTHLY=price_replace_solo_monthly
STRIPE_PRICE_SOLO_ANNUAL=price_replace_solo_annual
STRIPE_PRICE_TEAM_MONTHLY=price_replace_team_monthly
STRIPE_PRICE_TEAM_ANNUAL=price_replace_team_annual
STRIPE_PRICE_SETUP_SOLO=price_replace_setup_solo_490
STRIPE_PRICE_SETUP_TEAM=price_replace_setup_team_990
