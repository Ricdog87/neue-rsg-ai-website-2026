# HubSpot Meetings — public scheduling URL
NEXT_PUBLIC_HUBSPOT_MEETING_URL=https://meetings-eu1.hubspot.com/r-serrano

# Calendly fallback (optional)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/rsg-ai/demo

# Plausible / Vercel Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=rsg-ai.de
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Site
NEXT_PUBLIC_SITE_URL=https://www.rsg-ai.de

# Newsletter — Resend transactional sender (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# HMAC secret for double-opt-in tokens (any long random string)
NEWSLETTER_SECRET=replace-me-with-32-bytes-of-randomness

# ── Voice / Stripe Self-Serve ────────────────────────────────────
# Stripe Self-Serve-Checkout für Voice-Tiers (Solo/Team).
# Keys aus https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=REPLACE_ME_WITH_STRIPE_TEST_SECRET
STRIPE_WEBHOOK_SECRET=REPLACE_ME_WITH_STRIPE_WEBHOOK_SECRET
# Recurring prices (monatlich)
STRIPE_PRICE_SOLO_MONTHLY=REPLACE_ME_WITH_STRIPE_PRICE_ID
STRIPE_PRICE_TEAM_MONTHLY=REPLACE_ME_WITH_STRIPE_PRICE_ID
# Recurring prices (jährlich, −15 %, OHNE Setup)
STRIPE_PRICE_SOLO_ANNUAL=REPLACE_ME_WITH_STRIPE_PRICE_ID
STRIPE_PRICE_TEAM_ANNUAL=REPLACE_ME_WITH_STRIPE_PRICE_ID
# One-time setup prices (nur bei monatlich, einmalig auf 1. Rechnung)
STRIPE_PRICE_SETUP_SOLO=REPLACE_ME_WITH_STRIPE_PRICE_ID   # 490 € netto
STRIPE_PRICE_SETUP_TEAM=REPLACE_ME_WITH_STRIPE_PRICE_ID   # 990 € netto

# ── Callback notification ───────────────────────────────────────
# Slack/Telegram-Webhook für Rückruf-Requests (sub-second-Routing).
# Falls leer → Resend-Mail-Fallback auf CALLBACK_NOTIFY_EMAIL.
CALLBACK_NOTIFY_WEBHOOK=
CALLBACK_NOTIFY_EMAIL=hello@rsg-ai.de

# ── HubSpot (optional) ──────────────────────────────────────────
# Erstellt Deal in HubSpot bei checkout.session.completed.
# Falls leer → Webhook macht no-op, Stripe-Subscription läuft trotzdem.
HUBSPOT_PRIVATE_TOKEN=
